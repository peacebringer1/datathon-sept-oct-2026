{
  "name": "dataset-viewer",
  "version": "1.1.0",
  "description": "Аналитика демографии Казахстана",
  "author": "Chepoclad",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.datasetviewer.app",
    "productName": "Аналитика Демографии",
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "js": "^0.1.0"
  }
}
